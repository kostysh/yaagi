{
  "name": "yaagi",
  "description": "An implementation path for Polyphony: a long-lived, identity-bearing AI agent with model-independent continuity.",
  "keywords": [
    "agi",
    "ai-agent",
    "autonomous-agent",
    "digital-organism",
    "long-lived-agent",
    "local-ai",
    "agent-memory",
    "polyphony"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "format": "pnpm --filter './packages/*' --fail-if-no-match -r run format",
    "format:check": "pnpm --filter './packages/*' --fail-if-no-match -r run format:check",
    "lint": "pnpm --filter './packages/*' --fail-if-no-match -r run lint",
    "typecheck": "pnpm --filter './packages/*' --fail-if-no-match -r run typecheck",
    "build": "pnpm --filter './packages/*' --fail-if-no-match -r run build",
    "test": "pnpm --filter './packages/*' --fail-if-no-match -r run test"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@biomejs/biome": "2.5.14",
    "eslint": "10.11.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0"
  }
}
